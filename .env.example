# Server Environment
NODE_ENV=development

# Google Gemini API (Default free-tier-first provider)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude API (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (Optional for local or self-hosted deployment)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# GitHub Personal Access Token (Optional, for higher rate limits on public repos)
GITHUB_TOKEN=

# PostgreSQL Database (Optional for persistent caching/jobs; Neon/Supabase/Vercel Postgres)
DATABASE_URL=

# Processing Limits
MAX_REPOSITORY_FILES=500
MAX_FILE_BYTES=500000
MAX_REPOSITORY_BYTES=50000000
MAX_ANALYSIS_SECONDS=300
